{
  "name": "portfolio.client",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --host localhost --port 4200",
    "start:http": "ng serve --host localhost --port 4200",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "generate:api": "typedapi-generate",
    "generate:api:offline": "typedapi-generate --offline",
    "check:api": "typedapi-generate --check",
    "check:api:offline": "typedapi-generate --check --offline",
    "audit": "npm audit",
    "verify": "npm run build && npm run test && npm run check:api:offline && npm run audit"
  },
  "config": {
    "swaggerUrl": "http://localhost:5159/swagger/v1/swagger.json",
    "apiOutput": "src/api",
    "typedApiSwaggerBackupFile": "swagger/swagger.backup.json",
    "typedApiDownloadTimeoutMs": 15000,
    "typedApiCleanOutput": true,
    "typedApiGenerateMissingOperationIds": true,
    "typedApiMethodNameStyle": "operationId",
    "typedApiPrefixMethodNamesWithController": false
  },
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/router": "22.1.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typedapi-client-helpers": "0.3.6",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@types/jest": "^30.0.0",
    "jsdom": "30.0.1",
    "typescript": "~6.0.2",
    "vitest": "5.0.0"
  }
}
